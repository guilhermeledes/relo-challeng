{
  "name": "smartrr-refactoring-excercise",
  "version": "1.0.0",
  "description": "Gilded Rose kata in TypeScript",
  "scripts": {
    "precompile": "rimraf app/**/*.js test/**/*.js",
    "compile": "tsc",
    "pretest": "rimraf app/**/*.js test/**/*.js",
    "test:jest": "jest",
    "test:jest:watch": "jest --watchAll",
    "test:mocha": "NODE_OPTIONS='--disable-warning=MODULE_TYPELESS_PACKAGE_JSON' nyc mocha -r ts-node/register -r tsconfig-paths/register test/mocha/**/*.ts",
    "test:vitest": "vitest run --coverage",
    "test:vitest:watch": "vitest --coverage"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "chai": "^6.2.2",
    "jest": "^30.4.2",
    "mocha": "^11.3.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
